{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "debugpy",
            "name": "Train AI",
            "request": "launch",
            "program": "${workspaceFolder}/tools/ai/train.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "type": "debugpy",
            "name": "Score rocks",
            "request": "launch",
            "program": "${workspaceFolder}/tools/ai/score_rocks.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "type": "java",
            "name": "app",
            "request": "launch",
            "mainClass": "GemstoneGuardian/game.app",
            "projectName": "GemstoneGuardian"
        }
    ]
}